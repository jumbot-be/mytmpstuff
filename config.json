{
  "dashboard": {
    "name": "MultiRegion-Resource-Metrics",
    "prefix": "",
    "update_frequency": "rate(1 hour)"
  },
  "lambda": {
    "runtime": "python3.12",
    "memory_size": 512,
    "timeout": 300,
    "handler": "cloudwatch_dashboard_lambda.lambda_handler"
  },
  "regions": {
    "monitor_all": true,
    "specific_regions": [
      "us-east-1",
      "us-west-1",
      "us-west-2",
      "eu-west-1",
      "eu-central-1",
      "ap-southeast-1",
      "ap-northeast-1"
    ]
  },
  "metrics": {
    "rds": {
      "enabled": true,
      "time_series": [
        {
          "metric": "FreeStorageSpace",
          "label": "Free Storage Available",
          "statistic": "Average",
          "period": 300
        },
        {
          "metric": "DatabaseConnections",
          "label": "Connections",
          "statistic": "Average",
          "period": 300
        },
        {
          "metric": "CPUUtilization",
          "label": "CPU Utilization",
          "statistic": "Average",
          "period": 300
        },
        {
          "metric": "FreeableMemory",
          "label": "Free Memory",
          "statistic": "Average",
          "period": 300
        }
      ],
      "bar_charts": [
        {
          "metric": "FreeStorageSpace",
          "label": "FreeStorageSpace",
          "statistic": "Average",
          "period": 300
        }
      ]
    },
    "efs": {
      "enabled": true,
      "time_series": [
        {
          "metric": "StorageBytes",
          "label": "StorageBytes",
          "statistic": "Average",
          "period": 300
        }
      ],
      "bar_charts": [
        {
          "metric": "StorageBytes",
          "label": "StorageSpace",
          "statistic": "Average",
          "period": 300
        }
      ]
    },
    "vpn": {
      "enabled": true,
      "time_series": [
        {
          "metric": "TunnelState",
          "label": "Tunnel State",
          "statistic": "Minimum",
          "period": 300
        }
      ]
    },
    "ipsec": {
      "enabled": true,
      "time_series": [
        {
          "metric": "TunnelState",
          "label": "State",
          "statistic": "Minimum",
          "period": 300
        },
        {
          "metric": "TunnelDataIn",
          "label": "TunnelDataIn",
          "statistic": "Minimum",
          "period": 300
        }
      ]
    }
  },
  "deployment": {
    "s3_bucket": "your-s3-bucket-name",
    "s3_prefix": "lambda/cloudwatch-dashboard/",
    "stack_name": "cloudwatch-dashboard-generator"
  }
}
