# Hourly Logrotate configuration for specific system logs (syslog, auth.log, kern.log)
# and service logs (nginx, CrushFTP11)
# Supported by the hourly upload-s3 cron job.

/var/log/syslog
/var/log/auth.log
/var/log/kern.log
/var/log/nginx/*.log
/opt/CrushFTP11/*.log
{
    hourly
    missingok
    rotate 168
    notifempty
    nocreate
    nocompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate || systemctl kill -s HUP rsyslog || true
        systemctl reload nginx || true
    endscript
}
